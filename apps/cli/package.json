{
  "name": "@silo/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "silo": "src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "bunx tsc --noEmit",
    "test": "bun test",
    "format": "bunx prettier --check ."
  },
  "dependencies": {
    "@silo/core": "workspace:*"
  }
}
